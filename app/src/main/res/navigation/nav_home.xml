<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_home"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.deliciachef.ui.feature.home.search.SearchFragment"
        android:label="Buscar"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_searchFragment_to_recipeDetailFragment"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="com.deliciachef.ui.feature.home.detail.RecipeDetailFragment"
        android:label="Detalle de Receta"
        tools:layout="@layout/fragment_recipe_detail" />

    <fragment
        android:id="@+id/savedFragment"
        android:name="com.deliciachef.ui.feature.home.saved.SavedFragment"
        android:label="Guardados"
        tools:layout="@layout/fragment_saved">

        <action
            android:id="@+id/action_savedFragment_to_recipeDetailFragment"
            app:destination="@id/recipeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.deliciachef.ui.feature.home.calendar.CalendarFragment"
        android:label="Calendario"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.deliciachef.ui.feature.home.profile.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile" />

</navigation>